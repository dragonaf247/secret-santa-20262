PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Copy API ID from your SheetDB endpoint, never put it in public/app.js
SHEETDB_API_ID=YOUR_SHEETDB_API_ID
# Optional: SheetDB Bearer token if enabled in your SheetDB account
SHEETDB_API_TOKEN=

# Generate a unique random secret (32+ characters)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM

# First administrator created automatically at first server start
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow_2026_Strong!
ADMIN_FULL_NAME=Secret Santa Admin
